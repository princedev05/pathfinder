# Server Port (Default: 5000)
PORT=5000

# CORS Origin (Default: *)
CORS_ORIGIN=*

# MongoDB URI (Optional: system runs in-memory dataset mode if empty or not reachable)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/pathfinder?retryWrites=true&w=majority

# JWT Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# JWT Expiry
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
